<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mihir.tvhome"
    android:versionCode="2"
    android:versionName="1.1-gabriel">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Encerrar o Prime Video em segundo plano depois de trocar pelo YouTube. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Início"
        android:icon="@drawable/ic_home"
        android:banner="@drawable/ic_home"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Botao Netflix do controle: o sistema abre nflx://www.netflix.com/; aqui isso vira o UniTV. -->
        <activity
            android:name=".NetflixKeyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="nflx" android:host="www.netflix.com" />
            </intent-filter>
        </activity>

        <!-- Botao Apps (⋮⋮⋮) do controle abre o menu "Mais apps" (servico ativado por adb). -->
        <service
            android:name=".RemoteButtonsService"
            android:label="@string/remote_buttons_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_buttons" />
        </service>
    </application>
</manifest>
